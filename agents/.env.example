# =============================================================================
# A2A Multi-Agent System Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI Configuration (Required for Agno AGI Agent)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# This enables:
# - GPT-4o model for advanced reasoning
# - Text embeddings for knowledge base
# - Semantic search capabilities
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Anthropic Configuration (Optional - if you want to use Claude instead)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
# Currently not used since we're using OpenAI for everything
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Agent Port Configuration
# -----------------------------------------------------------------------------
# Customize ports if needed (defaults shown)
# PORT_FINANCE=9999
# PORT_IT=9998
# PORT_BUILDINGS=9997
# PORT_AGNO=9996

# -----------------------------------------------------------------------------
# Agent URL Configuration (for A2A communication)
# -----------------------------------------------------------------------------
# Override if running agents on different hosts
# A2A_URL_1=http://127.0.0.1:9999  # Finance Agent
# A2A_URL_2=http://127.0.0.1:9998  # IT Agent
# A2A_URL_3=http://127.0.0.1:9997  # Buildings Agent
# A2A_URL_4=http://127.0.0.1:9996  # Agno AGI Agent

# -----------------------------------------------------------------------------
# Agno AGI Configuration
# -----------------------------------------------------------------------------
# Knowledge base settings
AGNO_KNOWLEDGE_RECREATE=false  # Set to 'true' to rebuild knowledge base
AGNO_KNOWLEDGE_URLS=https://docs.agno.com/introduction.md

# Vector database settings
AGNO_VECTOR_DB_URI=tmp/lancedb
AGNO_VECTOR_DB_TABLE=agno_docs

# SQLite storage settings
AGNO_STORAGE_DB=tmp/agent.db
AGNO_STORAGE_TABLE=agent_sessions

# Model settings
AGNO_MODEL_ID=gpt-4o
AGNO_EMBEDDER_ID=text-embedding-3-small
AGNO_EMBEDDER_DIMENSIONS=1536

# Agent behavior settings
AGNO_HISTORY_RUNS=3
AGNO_TEMPERATURE=0.7
AGNO_MAX_TOKENS=2000

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Set to 'true' for verbose logging
DEBUG=false

# Set to 'development' or 'production'
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Next.js Frontend Configuration
# -----------------------------------------------------------------------------
# These are used by the Next.js application
NEXT_PUBLIC_API_URL=http://localhost:3000/api/copilotkit

# -----------------------------------------------------------------------------
# Instructions for Setup:
# -----------------------------------------------------------------------------
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your OpenAI API key to OPENAI_API_KEY=
# 3. Restart all agents: ./start_all_agents.sh
# 4. Test the system at http://localhost:3001
#
# Example:
# OPENAI_API_KEY=sk-proj-abc123...your-key-here
# =============================================================================
